{
  "manifestVersion": 1,
  "id": "rw-azure-boards-assistant",
  "name": "Azure Boards Assistant",
  "version": "0.1.0",
  "publisher": "rw-local-productivity",
  "description": "Local-first Azure Boards assistant panels for Work Items, Boards, Backlogs, Queries, and admin settings.",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "categories": [
    "Azure Boards"
  ],
  "icons": {
    "default": "../assets/azure-boards-small.svg"
  },
  "files": [
    {
      "path": "static",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "work-item-hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-work-web.work-hub-group"
      ],
      "properties": {
        "name": "Boards Assistant",
        "uri": "static/work-item-hub.html"
      }
    },
    {
      "id": "admin-settings",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-web.project-admin-hub-group"
      ],
      "properties": {
        "name": "Boards Assistant Settings",
        "uri": "static/admin-settings.html"
      }
    }
  ],
  "scopes": [
    "vso.work",
    "vso.work_write"
  ]
}
