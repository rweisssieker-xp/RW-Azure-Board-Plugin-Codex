# Azure Boards production deployment example
# Do not commit real secrets or tenant-specific values.

AZURE_BOARDS_TENANT_ID=<tenant-id-or-common>
AZURE_BOARDS_CLIENT_ID=<microsoft-entra-app-client-id>
AZURE_BOARDS_SCOPES=499b84ac-1321-427f-aa17-267ca6975798/.default offline_access openid profile

# Hosted MCP deployments should terminate TLS at an owned HTTPS domain.
AZURE_BOARDS_HOSTED_MCP_URL=https://your-owned-domain.example/mcp

# Optional deterministic default. Set to openai or private only after data policy approval.
AZURE_BOARDS_LLM_MODE=deterministic-local
AZURE_BOARDS_LLM_MODEL=

# Local artifact store for snapshots, baselines, approval queues, audit trails, and decision packs.
AZURE_BOARDS_STORE_DIR=<secure-user-or-service-store-path>

# Optional local development only. Do not require PAT entry for App Directory review.
# AZURE_BOARDS_PAT=
# AZURE_DEVOPS_PAT=
# AZURE_BOARDS_BEARER_TOKEN=
